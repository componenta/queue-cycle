{
    "name": "componenta/queue-cycle",
    "description": "Transactional PostgreSQL queue adapter for Componenta Queue using Cycle Database.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "php-64bit": "^8.5.13",
        "ext-pdo_pgsql": "*",
        "componenta/queue": "^1.0",
        "cycle/database": "^2.24"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Queue\\Cycle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Queue\\Cycle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --colors=never",
        "analyse": "phpstan analyse --no-progress",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@cs:check"
        ],
        "bench": "@php benchmarks/QueueWorkload.php"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
